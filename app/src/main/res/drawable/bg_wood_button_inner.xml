<?xml version="1.0" encoding="utf-8"?>
<!-- Lõi nút gỗ, viền sáng 1dp phía trên -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/button_highlight" />
            <corners android:radius="@dimen/wood_button_inner_radius" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape>
            <solid android:color="@color/orange_button" />
            <corners android:radius="@dimen/wood_button_inner_radius" />
        </shape>
    </item>
</layer-list>
