<?xml version="1.0" encoding="utf-8"?>
<!-- Viền ngoài nút gỗ + đổ bóng trong (Figma: inset 0 -1 0 2) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/brown_dark" />
            <corners android:radius="@dimen/wood_button_outer_radius" />
        </shape>
    </item>
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="3dp">
        <shape>
            <solid android:color="@color/brown_primary" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
