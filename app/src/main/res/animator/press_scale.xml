<?xml version="1.0" encoding="utf-8"?>
<!-- Hiệu ứng nhấn chung: scale 0.95 trong 100ms -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="@integer/press_anim_ms" android:propertyName="scaleX" android:valueTo="0.95" android:valueType="floatType" />
            <objectAnimator android:duration="@integer/press_anim_ms" android:propertyName="scaleY" android:valueTo="0.95" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="@integer/press_anim_ms" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="@integer/press_anim_ms" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
