<?xml version="1.0" encoding="utf-8"?>
<!-- Choose color (Figma 69:101) -->
<com.conght.facemakerapp.core.widget.PaperDialogContainer xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content"
    app:dialogTitle="@string/choose_color"
    app:endText="@string/done"
    app:startText="@string/cancel">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.conght.facemakerapp.core.widget.SaturationValueView
            android:id="@+id/sv_picker"
            android:layout_width="@dimen/color_picker_sv_w"
            android:layout_height="@dimen/color_picker_sv_h" />

        <com.conght.facemakerapp.core.widget.HueBarView
            android:id="@+id/hue_bar"
            android:layout_width="@dimen/color_picker_sv_w"
            android:layout_height="@dimen/color_picker_hue_h"
            android:layout_marginTop="@dimen/color_picker_gap" />
    </LinearLayout>
</com.conght.facemakerapp.core.widget.PaperDialogContainer>
