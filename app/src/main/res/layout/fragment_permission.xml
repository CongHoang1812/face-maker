<?xml version="1.0" encoding="utf-8"?>
<!-- Permission (Figma 3:741) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/top_bar_top"
        android:text="@string/permission"
        android:textAppearance="@style/Text.Title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_image"
        android:layout_width="@dimen/permission_image"
        android:layout_height="@dimen/permission_image"
        android:layout_marginTop="@dimen/list_top"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_permission"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/row_media"
        layout="@layout/item_permission_row"
        android:layout_width="0dp"
        android:layout_height="@dimen/language_item_h"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/screen_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_image" />

    <include
        android:id="@+id/row_notification"
        layout="@layout/item_permission_row"
        android:layout_width="0dp"
        android:layout_height="@dimen/language_item_h"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/screen_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/row_media" />

    <TextView
        android:id="@+id/tv_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="@dimen/permission_continue_gap"
        android:background="?attr/selectableItemBackground"
        android:text="@string/continue_text"
        android:textAppearance="@style/Text.Body.Orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/row_notification" />
</androidx.constraintlayout.widget.ConstraintLayout>
