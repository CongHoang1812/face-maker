<?xml version="1.0" encoding="utf-8"?>
<!-- Skeleton tab category 56×48 bo trên 8, nằm đáy hàng tab cao 56 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/category_tab_w"
    android:layout_height="@dimen/category_tab_selected_h">

    <com.conght.facemakerapp.core.widget.SkeletonView
        android:layout_width="match_parent"
        android:layout_height="@dimen/category_tab_h"
        android:layout_gravity="bottom"
        app:skeletonRadius="@dimen/category_tab_radius"
        app:skeletonShape="topRounded" />
</FrameLayout>
