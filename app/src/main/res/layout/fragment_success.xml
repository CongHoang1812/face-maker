<?xml version="1.0" encoding="utf-8"?>
<!-- Successful (Figma 3:1109 maker; 3:223 cosplay: thêm huy hiệu 3 sao + viền ảnh, ảnh dịch xuống) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_bg"
    tools:ignore="Overdraw">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top bar: re-edit | share, my creation, home -->
        <com.conght.facemakerapp.core.widget.RoundIconButton
            android:id="@+id/btn_re_edit"
            android:layout_width="@dimen/icon_button_large"
            android:layout_height="@dimen/icon_button_large"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/top_bar_top"
            android:contentDescription="@string/cd_re_edit"
            app:icon="@drawable/ic_rotate_right"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.conght.facemakerapp.core.widget.RoundIconButton
            android:id="@+id/btn_home"
            android:layout_width="@dimen/icon_button_large"
            android:layout_height="@dimen/icon_button_large"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginTop="@dimen/top_bar_top"
            android:contentDescription="@string/cd_home"
            app:icon="@drawable/ic_home"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_my_creation"
            style="@style/Widget.FaceMaker.ImageIconButton"
            android:layout_marginEnd="@dimen/top_bar_action_gap"
            android:contentDescription="@string/cd_my_creation"
            android:src="@drawable/ic_archive"
            app:layout_constraintEnd_toStartOf="@id/btn_home"
            app:layout_constraintTop_toTopOf="@id/btn_home" />

        <com.conght.facemakerapp.core.widget.RoundIconButton
            android:id="@+id/btn_share"
            android:layout_width="@dimen/icon_button_large"
            android:layout_height="@dimen/icon_button_large"
            android:layout_marginEnd="@dimen/top_bar_action_gap"
            android:contentDescription="@string/cd_share"
            app:icon="@drawable/ic_share"
            app:layout_constraintEnd_toStartOf="@id/btn_my_creation"
            app:layout_constraintTop_toTopOf="@id/btn_home" />

        <!-- Ảnh kết quả 328×328 nền trắng (cosplay: viền nâu 4dp) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_result"
            android:layout_width="@dimen/character_size"
            android:layout_height="@dimen/character_size"
            android:layout_marginTop="@dimen/content_top"
            android:background="@color/white"
            android:contentDescription="@string/cd_result_image"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.FaceMaker.DecorItem"
            app:strokeColor="@color/brown_primary" />

        <!-- Huy hiệu 3 sao (chỉ COSPLAY) nằm sát mép trên ảnh -->
        <LinearLayout
            android:id="@+id/star_badge"
            android:layout_width="@dimen/success_badge_w"
            android:layout_height="@dimen/success_badge_h"
            android:background="@drawable/bg_star_badge"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="@dimen/wood_button_inset_h"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/iv_result"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/iv_star_1"
                android:layout_width="@dimen/success_star_small"
                android:layout_height="@dimen/success_star_small"
                android:importantForAccessibility="no"
                android:src="@drawable/img_star_off" />

            <ImageView
                android:id="@+id/iv_star_2"
                android:layout_width="@dimen/success_star_big"
                android:layout_height="@dimen/success_star_big"
                android:layout_marginHorizontal="@dimen/grid_gap"
                android:importantForAccessibility="no"
                android:src="@drawable/img_star_off" />

            <ImageView
                android:id="@+id/iv_star_3"
                android:layout_width="@dimen/success_star_small"
                android:layout_height="@dimen/success_star_small"
                android:importantForAccessibility="no"
                android:src="@drawable/img_star_off" />
        </LinearLayout>

        <com.conght.facemakerapp.core.widget.WoodButton
            android:id="@+id/btn_download"
            style="@style/Widget.FaceMaker.WoodButton"
            android:layout_marginTop="@dimen/screen_padding"
            android:text="@string/download"
            app:buttonWidth="@dimen/wood_button_large_width"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_result" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
