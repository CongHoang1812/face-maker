<?xml version="1.0" encoding="utf-8"?>
<!-- Ô lưới editor 56×56 trắng bo 4 (màu / ảnh / bánh xe màu / thêm ảnh / item pack) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/decor_item"
    android:background="@drawable/bg_decor_item"
    android:focusable="true"
    android:foreground="@drawable/fg_decor_item_selected">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.FaceMaker.DecorItem"
        tools:ignore="ContentDescription" />
</FrameLayout>
