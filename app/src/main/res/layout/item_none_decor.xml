<?xml version="1.0" encoding="utf-8"?>
<!-- Ô "None" thật (không shimmer) đứng đầu lưới item editor -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/decor_item"
    android:background="@drawable/bg_decor_item_state"
    android:contentDescription="@string/cd_none"
    android:focusable="true">

    <ImageView
        android:layout_width="@dimen/color_dot"
        android:layout_height="@dimen/color_dot"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_none_editor" />
</FrameLayout>
