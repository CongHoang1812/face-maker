<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.conght.facemakerapp.feature.splash.SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_language"
            app:destination="@id/languageFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_splash_to_intro"
            app:destination="@id/introFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/languageFragment"
        android:name="com.conght.facemakerapp.feature.language.LanguageFragment"
        tools:layout="@layout/fragment_language">
        <argument
            android:name="fromSetting"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_language_to_intro"
            app:destination="@id/introFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/introFragment"
        android:name="com.conght.facemakerapp.feature.intro.IntroFragment"
        tools:layout="@layout/fragment_intro">
        <argument
            android:name="onboardingDone"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_intro_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_main"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_intro_to_permission"
            app:destination="@id/permissionFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/permissionFragment"
        android:name="com.conght.facemakerapp.feature.permission.PermissionFragment"
        tools:layout="@layout/fragment_permission">
        <action
            android:id="@+id/action_permission_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_main"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.conght.facemakerapp.feature.home.HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_setting"
            app:destination="@id/settingFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_home_to_templateSelect"
            app:destination="@id/templateSelectFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_home_to_cosplayStart"
            app:destination="@id/cosplayStartFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_home_to_luckyRoll"
            app:destination="@id/luckyRollFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_home_to_myCreation"
            app:destination="@id/myCreationFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/settingFragment"
        android:name="com.conght.facemakerapp.feature.setting.SettingFragment"
        tools:layout="@layout/fragment_setting">
        <action
            android:id="@+id/action_setting_to_language"
            app:destination="@id/languageFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/templateSelectFragment"
        android:name="com.conght.facemakerapp.feature.maker.template.TemplateSelectFragment"
        tools:layout="@layout/fragment_template_select">
        <action
            android:id="@+id/action_templateSelect_to_customize"
            app:destination="@id/customizeFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/customizeFragment"
        android:name="com.conght.facemakerapp.feature.maker.customize.CustomizeFragment"
        tools:layout="@layout/fragment_customize">
        <argument
            android:name="templateId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="configJson"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="mode"
            android:defaultValue="MAKER"
            app:argType="string" />
        <action
            android:id="@+id/action_customize_to_decorEditor"
            app:destination="@id/decorEditorFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/decorEditorFragment"
        android:name="com.conght.facemakerapp.feature.decor.editor.DecorEditorFragment"
        tools:layout="@layout/fragment_decor_editor">
        <argument
            android:name="characterPath"
            app:argType="string" />
        <argument
            android:name="configJson"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_decorEditor_to_success"
            app:destination="@id/successFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/successFragment"
        android:name="com.conght.facemakerapp.feature.success.SuccessFragment"
        tools:layout="@layout/fragment_success">
        <argument
            android:name="creationId"
            app:argType="long" />
        <argument
            android:name="source"
            android:defaultValue="MAKER"
            app:argType="string" />
        <argument
            android:name="stars"
            android:defaultValue="0"
            app:argType="integer" />
        <action
            android:id="@+id/action_success_to_myCreation"
            app:destination="@id/myCreationFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/myCreationFragment"
        android:name="com.conght.facemakerapp.feature.creation.MyCreationFragment"
        tools:layout="@layout/fragment_my_creation">
        <argument
            android:name="tab"
            android:defaultValue="DESIGN"
            app:argType="string" />
        <action
            android:id="@+id/action_myCreation_to_creationDetail"
            app:destination="@id/creationDetailFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_myCreation_to_customize"
            app:destination="@id/customizeFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/creationDetailFragment"
        android:name="com.conght.facemakerapp.feature.creation.CreationDetailFragment"
        tools:layout="@layout/fragment_creation_detail">
        <argument
            android:name="creationId"
            app:argType="long" />
        <action
            android:id="@+id/action_creationDetail_to_customize"
            app:destination="@id/customizeFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_creationDetail_to_decorEditor"
            app:destination="@id/decorEditorFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/cosplayStartFragment"
        android:name="com.conght.facemakerapp.feature.cosplay.CosplayStartFragment"
        tools:layout="@layout/fragment_cosplay_start">
        <action
            android:id="@+id/action_cosplayStart_to_cosplayPlay"
            app:destination="@id/cosplayPlayFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <!-- Màn chơi Cosplay = Customize ở mode COSPLAY (tái dùng layout/logic bước 9) -->
    <fragment
        android:id="@+id/cosplayPlayFragment"
        android:name="com.conght.facemakerapp.feature.maker.customize.CustomizeFragment"
        tools:layout="@layout/fragment_customize">
        <argument
            android:name="mode"
            android:defaultValue="COSPLAY"
            app:argType="string" />
        <argument
            android:name="templateId"
            app:argType="string" />
        <argument
            android:name="challengeJson"
            app:argType="string" />
        <action
            android:id="@+id/action_cosplayPlay_to_success"
            app:destination="@id/successFragment"
            app:popUpTo="@id/cosplayStartFragment"
            app:popUpToInclusive="false"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/luckyRollFragment"
        android:name="com.conght.facemakerapp.feature.luckyroll.LuckyRollFragment"
        tools:layout="@layout/fragment_lucky_roll">
        <action
            android:id="@+id/action_luckyRoll_to_customize"
            app:destination="@id/customizeFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>
</navigation>
